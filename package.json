{
  "name": "la-permanence",
  "productName": "La Permanence",
  "version": "1.5.4",
  "description": "La Permanence — jeu d'avocat pénaliste, hors ligne.",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "node electron/paquet-jeu.js --version-livree && electron-builder --mac dir -c.mac.identity=-",
    "build:zip": "node electron/paquet-jeu.js --version-livree && electron-builder --mac zip --arm64 --x64 -c.mac.identity=-",
    "test:app": "node electron/test-app.js",
    "paquet": "node electron/paquet-jeu.js",
    "test:maj": "node electron/test-maj.js",
    "test:son": "node electron/test-son.js",
    "test:maj:module": "LP_SANS_APP=1 node electron/test-maj.js"
  },
  "devDependencies": {
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "playwright": "1.63.0"
  },
  "build": {
    "appId": "fr.lapermanence.jeu",
    "productName": "La Permanence",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "js/**",
      "lib/**",
      "fonts/**",
      "electron/main.js",
      "electron/maj.js",
      "electron/jeu-version.json",
      "electron/maj-cle-publique.pem",
      "LICENCES.md"
    ],
    "mac": {
      "category": "public.app-category.simulation-games",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "copyright": "© 2026 Kevin — La Permanence"
  },
  "author": "Kevin"
}
