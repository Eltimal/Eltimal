{
  "name": "la-permanence",
  "productName": "La Permanence",
  "version": "1.0.0",
  "description": "La Permanence — jeu d'avocat pénaliste, hors ligne.",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "node electron/paquet-jeu.js --version-livree && electron-builder --mac",
    "build:zip": "node electron/paquet-jeu.js --version-livree && electron-builder --mac zip --arm64 --x64",
    "test:app": "node electron/test-app.js",
    "paquet": "node electron/paquet-jeu.js",
    "test:maj": "node electron/test-maj.js"
  },
  "devDependencies": {
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "playwright": "1.63.0"
  },
  "build": {
    "appId": "fr.lapermanence.jeu",
    "productName": "La Permanence",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "js/**",
      "lib/**",
      "fonts/**",
      "electron/main.js",
      "electron/maj.js",
      "electron/jeu-version.json",
      "electron/maj-cle.txt"
    ],
    "mac": {
      "category": "public.app-category.simulation-games",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-"
    }
  },
  "author": "Kevin"
}
